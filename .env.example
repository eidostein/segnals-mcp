# Required — your Segnals API key (generate at https://segnals.com Settings → API Keys)
SEGNALS_API_KEY=sk_live_your_key_here

# Several accounts — instead of SEGNALS_API_KEY, a JSON file of labelled keys (chmod 600).
# See docs/CONFIGURATION.md → Several accounts.
# SEGNALS_ACCOUNTS_FILE=/absolute/path/to/accounts.json

# Optional — override the API base URL (default: https://segnals.com/api)
# SEGNALS_API_BASE=https://segnals.com/api
